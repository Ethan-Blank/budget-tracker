# Automatically normalize line endings for text files
* text=auto

# Explicitly handle common file types
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.tf text eol=lf
*.sh text eol=lf

# Keep JSON, YAML, config files consistent
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-specific batch files stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
